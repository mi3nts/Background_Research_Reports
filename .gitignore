.DS_Store
__pycache__/
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
claude/cache/
claude/build/
claude/fig/
claude/rebuild/
# claude/issues/ is deliberately NOT ignored: it is the archive of each issue's
# .tex source. build/ is scratch and gets overwritten every run, so without the
# archive a published issue cannot be corrected without re-authoring it.

# proofing debris from the pre-migration snapshot (delete manually on a local
# checkout; the automation sandbox mount is delete-restricted)
claude/pg-*.png
claude/prev*/
claude/digest.tex
claude/digest.pdf
claude/table_rows.tex
claude/l[0-9].txt
claude/log[0-9].txt

# session tooling, not part of the pipeline
.claude/

# superseded state moved aside (mount is delete-restricted; remove on a local checkout)
claude/state/.retired/
claude/build/trash/

# 2026-08-08: a pre-proof weekly build was renamed aside so the rollup would rebuild
# (rollup() is idempotent and skips when the output exists). rm is EPERM on this mount.
# Delete manually on a local checkout: Reports/weekly/.trash_weekly_0808.pdf
Reports/**/.trash_*.pdf
